rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin check function
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'himanshu0481@gmail.com' || 
         request.auth.token.email == 'admin@prathamkarigiri.com');
    }

    // Products collection: Anyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection: Anyone can create (checkout), users read own, admins manage all
    match /orders/{orderId} {
      allow create: if true;
      // Allow users to read their own orders securely
      allow read: if request.auth != null && (
        (resource != null && resource.data.user == request.auth.uid) ||
        (resource != null && request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );
      // Admin overrides
      allow read, update, delete: if isAdmin();
    }

    // Carts collection: Users read/write their own sync state, Admin overrides
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // Wishlists collection: Users read/write their own sync state, Admin overrides
    match /wishlists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // Reels & Config: Public read, Admin write
    match /reels/{reelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: Read/Write their own data, Admin manages all
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // Default: Deny all other collections unless specified
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}